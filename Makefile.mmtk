# Build glue for the in-tree MMTk binding (gc/mmtk). The binding is a Rust Cargo
# workspace producing a staticlib (libmmtk_ocaml.a). MMTk is the always-on
# collector (M9). The staticlib's objects are bundled (MMTK_BUNDLE, below) into
# the runtime static archives (lib{asm,caml}run*.a) that the compiler always
# links, so the GC glue (mmtk_ocaml_*, referenced from runtime/mmtk.c) resolves
# in every native and -custom bytecode program WITHOUT a bare "-lmmtk_ocaml" in
# config's {bytecomp,native}_c_libraries. (The old "-lmmtk_ocaml" mechanism
# broke third-party dune-configurator feature-probes that link via bare `cc`
# without OCaml's -L<stdlib>; see GH#10 and configure.ac.)
#
# This fragment is included by the top-level Makefile after Makefile.common.

MMTK_DIR   = $(ROOTDIR)/gc/mmtk
MMTK_LIB   = $(MMTK_DIR)/target/release/libmmtk_ocaml.a
MMTK_CARGO ?= cargo

# Native libraries the Rust staticlib transitively depends on. Obtained via:
#   cargo rustc --release -p mmtk-ocaml --lib -- --print native-static-libs
# TODO(M4/packaging): derive these at ./configure time instead of hardcoding
# per-OS here.
MMTK_UNAME_S := $(shell uname -s)
ifeq ($(MMTK_UNAME_S),Darwin)
  MMTK_NATIVE_LIBS = -lobjc -framework IOKit -framework CoreFoundation -liconv
else
  MMTK_NATIVE_LIBS = -ldl -lpthread -lm
endif

# Everything to append to a runtime-executable link line so the binding
# resolves. Since GH#10 the staticlib's objects are bundled INTO the runtime
# archives (see MMTK_BUNDLE below), so the runtime executables (ocamlrun*, which
# already link lib{caml}run*.a) pull mmtk_ocaml_* from the archive -- we must
# NOT re-add $(MMTK_LIB) here or every symbol would be defined twice
# (duplicate-symbol link error). Only MMTk's transitive system deps remain.
MMTK_LINK = $(MMTK_NATIVE_LIBS)

# Bundling the Rust staticlib into the runtime archives (GH#10).
#
# The compiler links lib{asm,caml}run*.a into every native / -custom bytecode
# program, and those archives reference mmtk_ocaml_* (runtime/mmtk.c). We make
# those references resolve by merging libmmtk_ocaml.a's *objects* directly into
# each runtime archive at build time (see the archive rules in the top-level
# Makefile). This replaces the old "-lmmtk_ocaml" in config's *_c_libraries,
# which was unresolvable by third-party dune-configurator probes that link via
# bare `cc` without OCaml's -L<stdlib> (GH#10). We keep the per-object structure
# (we do NOT ld -r into one blob), so the linker still pulls only the objects a
# program actually uses -- no per-binary bloat.
#
# Objects are staged once into $(MMTK_OBJS_DIR) (extracted from libmmtk_ocaml.a;
# the 490 members have unique, non-colliding names that don't clash with the
# runtime's own *.n.o/*.b.o), then appended to each archive with `ar r` and the
# index rebuilt. RANLIB keeps macOS happy (GNU `ar r` already refreshes the
# index; macOS `ar`'s does too, but an explicit ranlib is the portable
# belt-and-braces).
MMTK_OBJS_DIR = $(ROOTDIR)/runtime/mmtk_objs
MMTK_OBJS_STAMP = $(MMTK_OBJS_DIR)/.stamp

# Extract the staticlib's objects once. `ar x` writes them into CWD, so cd into
# the staging dir; use the absolute archive path since $(MMTK_LIB) is
# $(ROOTDIR)- relative ("./gc/mmtk/...") and would be wrong after the cd. The
# stamp tracks freshness against $(MMTK_LIB).
# Strip the embedded LLVM bitcode from the extracted objects.
#
# rustc leaves .llvmbc/.llvmcmd in every object. A binutils ld/nm that
# auto-loads an LLVM gold plugin will try to read those sections, and if the
# plugin is OLDER than the LLVM rustc built with, it fails and the member is
# reported as having NO SYMBOLS AT ALL — so every Rust runtime symbol
# (core::fmt::write, std::process::abort, __rdl_alloc, ...) silently vanishes
# and the runtime link dies with undefined references that name Rust internals
# rather than the plugin. Observed on a host carrying a stale LLVM-14 plugin:
#
#   bfd plugin: LLVM gold plugin has failed to create LTO module:
#   Opaque pointers are only supported in -opaque-pointers mode
#   (Producer: 'LLVM22.1.2-rust-1.96.0-stable' Reader: 'LLVM 14.0.6')
#
# The failure is nasty to diagnose because the object files are BYTE-IDENTICAL
# to ones that link fine elsewhere (same md5) — only the reader differs — and
# an archive-wide `nm` under-reports without an obvious error. Stripping costs
# nothing here: we never LTO across the C/Rust boundary, so the bitcode is dead
# weight, and native code plus .symtab are untouched (verified: the same object
# goes from "no symbols" to its full 1778).
#
# Best-effort: `-` because objcopy may be absent, and the strip is only needed
# on hosts with the stale plugin.
MMTK_STRIP_BITCODE = -$(OBJCOPY) --remove-section=.llvmbc --remove-section=.llvmcmd
OBJCOPY ?= objcopy

$(MMTK_OBJS_STAMP): $(MMTK_LIB)
	rm -rf $(MMTK_OBJS_DIR)
	mkdir -p $(MMTK_OBJS_DIR)
	cd $(MMTK_OBJS_DIR) && $(ARCMD) x $(abspath $(MMTK_LIB))
	$(MMTK_STRIP_BITCODE) $(MMTK_OBJS_DIR)/*.o 2>/dev/null || true
	touch $@

# Canned recipe: bundle the staged MMTk objects into archive $(1). Used in the
# top-level Makefile right after each runtime archive is created by MKLIB.
# `ar r` already refreshes the symbol index on GNU and macOS ar; the explicit
# ranlib is portable belt-and-braces (and a no-op-cost on Linux).
MMTK_RANLIB ?= ranlib
define MMTK_BUNDLE
$(ARCMD) r $(1) $(MMTK_OBJS_DIR)/*.o
$(MMTK_RANLIB) $(1)
endef

# Strip the absolute build directory out of the staticlib's embedded DWARF. The
# release profile keeps debug info (gc/mmtk/Cargo.toml: debug = true) for
# gdb/lldb, but that bakes $(ROOTDIR) into libmmtk_ocaml.a -- and, via the
# linker, into every native executable that links it. That breaks the
# relocatability check (testsuite/tools/testRelocation.ml), exactly as an
# un-prefix-mapped C object would. This is the Rust equivalent of the C
# toolchain's -fdebug-prefix-map (cc_has_debug_prefix_map): remap the build root
# to a relative "." so the debug info stays useful but carries no build-dir
# path. (The cargo registry paths under ~/.cargo are not the build root/prefix,
# so the relocatability check ignores them; only the build root needs
# remapping.) Cargo embeds *absolute* source paths in the DWARF, so the map
# source must be the absolute build root ($(ROOTDIR) is relative -- "." -- at
# top level).
MMTK_RUSTFLAGS = --remap-path-prefix=$(abspath $(ROOTDIR))=.

# Build the staticlib via Cargo. Declared PHONY so Cargo's own incremental
# build decides whether a rebuild is needed (cheap when up to date).
.PHONY: mmtk-lib
mmtk-lib:
	@# RQ8: mmtk-core is now a git submodule (gc/mmtk-core, the [patch.crates-io]
	@# target). A fresh clone has it empty, which breaks the cargo build below;
	@# initialise it on demand so a plain `make` works without a manual step.
	@test -f $(ROOTDIR)/gc/mmtk-core/Cargo.toml || \
	  git -C $(ROOTDIR) submodule update --init gc/mmtk-core
	RUSTFLAGS='$(MMTK_RUSTFLAGS)' \
	  $(MMTK_CARGO) build --release --manifest-path $(MMTK_DIR)/Cargo.toml

$(MMTK_LIB): mmtk-lib

# Remove the staged MMTk objects on clean (the runtime archives themselves are
# removed by the top-level Makefile's runtime clean::).
clean::
	rm -rf $(MMTK_OBJS_DIR)
